{
  "name": "h3-motion",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env scripts/dev.ts",
    "dev:app": "npm run build -w @h3-motion/shared && concurrently -k -n shared,server,web \"npm run watch -w @h3-motion/shared\" \"npm run dev -w @h3-motion/server\" \"npm run dev -w @h3-motion/web\"",
    "build": "tsc -b && npm run bundle -w @h3-motion/web",
    "start": "npm run start -w @h3-motion/server",
    "test": "vitest run",
    "check-env": "node --import tsx --env-file-if-exists=.env scripts/check-env.ts",
    "spike": "node --import tsx --env-file-if-exists=.env scripts/spikes/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
